{
  "name": "flex",
  "version": "2.0.1",
  "keywords": [
    "streaming-services"
  ],
  "homepage": "https://kinoflex.ru/",
  "author": {
    "name": "torislav"
  },
  "files": [
    "dist",
    "icon.*",
    "manifest.json"
  ],
  "main": "dist/flex.cjs",
  "scripts": {
    "dev": "azot dev",
    "build": "azot build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "manifest": "azot manifest --input flex.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "azot": "^5.0.0-alpha.91",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "picomatch": "^4.0.7",
    "semver": "^7.8.5",
    "tree-kill": "^1.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "azot": ">=5.0.0-alpha.94",
    "node": ">=24.22.1"
  }
}
